# Copy to .env and fill in real values. Placeholders only: never commit real keys.

# Developers > API keys & clients. cg_test_... for test mode, cg_live_... for live mode.
CLIKGATE_API_KEY=cg_test_replace_me
# Apps > your app > Identity secret. Optional: without it the app uses the installation header (Path B).
CLIKGATE_IDENTITY_SECRET=replace_me
# Developers > Webhooks, shown once when you add the endpoint.
CLIKGATE_WEBHOOK_SECRET=whsec_replace_me
# Your referral program's ID (rpg_...).
CLIKGATE_REFERRAL_PROGRAM_ID=rpg_replace_me
# Optional: where this backend listens.
ASPNETCORE_URLS=http://localhost:5000
