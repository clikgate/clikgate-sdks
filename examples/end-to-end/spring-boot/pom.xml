<?xml version="1.0" encoding="UTF-8"?>
<!-- End-to-end sample backend for a mobile app: Spring Boot 4 and the Clikgate starter.
     Run steps are in README.md. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>com.example</groupId>
  <artifactId>clikgate-end-to-end-spring-boot</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>17</java.version>
    <!-- Built from this repository (see README.md). Switch to the published release when it is out. -->
    <clikgate.version>2.1.1</clikgate.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.clikgate</groupId>
      <artifactId>clikgate-spring-boot-starter</artifactId>
      <version>${clikgate.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
