<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.clikgate</groupId>
    <artifactId>clikgate-java-parent</artifactId>
    <version>1.1.0</version>
  </parent>

  <artifactId>clikgate-java</artifactId>
  <name>Clikgate Java SDK</name>
  <description>The official Clikgate server SDK for Java and Kotlin (Java 8+): goals, click IDs, webhooks, links and private mode. One runtime dependency: Jackson databind.</description>
  <url>https://clikgate.com/docs/sdks/java</url>

  <dependencies>
    <!-- the one runtime dependency (S.13): declared, not shaded -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- nullability annotations (Kotlin reads them); optional, not needed at runtime -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- used when the application has SLF4J; otherwise java.util.logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.clikgate</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- -Dconformance runs the cross-language suite (ConformanceTest) against the shared mock server -->
          <systemPropertyVariables>
            <clikgate.conformance>${conformance}</clikgate.conformance>
            <clikgate.conformance.filter>${conformance.filter}</clikgate.conformance.filter>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <conformance>false</conformance>
    <conformance.filter></conformance.filter>
  </properties>
</project>
