{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node", "react"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@clikgate/node": ["../../src/index.ts"],
      "@clikgate/node/next": ["../../src/next.ts"],
      "next/*": ["../../node_modules/next/*"],
      "react": ["../../node_modules/@types/react"]
    }
  },
  "include": ["proxy.ts", "app", "lib"]
}
