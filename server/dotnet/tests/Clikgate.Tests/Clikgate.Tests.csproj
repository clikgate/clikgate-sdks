<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CI runs every supported runtime: -p:TestTfms="net8.0;net10.0" (plus net472 on Windows, the netstandard2.0 build) -->
    <TargetFrameworks Condition="'$(TestTfms)' == ''">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TestTfms)' != ''">$(TestTfms)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA2007;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Clikgate/Clikgate.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="../../src/Clikgate.AspNetCore/Clikgate.AspNetCore.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
