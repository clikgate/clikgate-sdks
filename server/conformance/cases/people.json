{
  "$schema": "../schema/case.schema.json",
  "suite": "people",
  "description": "identifyUser() and goal labels (SPEC 24; backend change 14 B.5)",
  "cases": [
    {
      "id": "people.identify.click_customer_label",
      "description": "A click, a customer ID and a label map to the wire; the person is returned",
      "responses": [
        {
          "status": 200,
          "json": {
            "object": "person_identified",
            "person_id": "per_01JCK8Z9V7Q4M2N6P8R0S2T4PE",
            "label_ignored": null
          },
          "headers": {
            "x-request-id": "req_ok"
          }
        }
      ],
      "steps": [
        {
          "call": "identify_user",
          "args": {
            "click_id": "clk_01JCK8Z9V7Q4M2N6P8R0S2T4W6",
            "customer_id": "user_42",
            "label": "Ada (VIP)"
          },
          "expect": {
            "result": {
              "object": "person_identified",
              "person_id": "per_01JCK8Z9V7Q4M2N6P8R0S2T4PE",
              "label_ignored": null
            }
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/v1/people/identify",
            "json": {
              "click_id": "clk_01JCK8Z9V7Q4M2N6P8R0S2T4W6",
              "customer_id": "user_42",
              "label": "Ada (VIP)"
            }
          }
        ]
      },
      "now_ms": 1793016000000
    },
    {
