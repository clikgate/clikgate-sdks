      "now_ms": 1793016000000
    },
    {
      "id": "people.identify.private_mode_customer_refused",
      "description": "In private mode the customer ID is refused by the guard; a label is allowed (the API checks the switch)",
      "client": {
        "private_mode": true
      },
      "responses": [
        {
          "status": 200,
          "json": {
            "object": "person_identified",
            "person_id": "per_01JCK8Z9V7Q4M2N6P8R0S2T4PE",
            "label_ignored": null
          },
          "headers": {
            "x-request-id": "req_ok"
          }
        }
      ],
      "steps": [
        {
          "call": "identify_user",
          "args": {
            "click_id": "clk_01JCK8Z9V7Q4M2N6P8R0S2T4W6",
            "customer_id": "secret@example.com"
          },
          "expect": {
            "error": {
              "class": "PrivateModeFieldRejectedError",
              "code": "private_mode_field_rejected",
              "field": "customer_id",
              "param": "customer_id",
              "http_status": null,
              "message_excludes": [
                "secret@example.com"
              ]
            }
          }
        },
        {
          "call": "identify_user",
          "args": {
            "click_id": "clk_01JCK8Z9V7Q4M2N6P8R0S2T4W6",
            "label": "Ada"
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/v1/people/identify",
            "json": {
              "click_id": "clk_01JCK8Z9V7Q4M2N6P8R0S2T4W6",
              "label": "Ada"
            }
          }
        ],
        "logs_exclude": [
          "secret@example.com"
        ]
      },
      "now_ms": 1793016000000
    },
    {
