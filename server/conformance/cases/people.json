        {
          "call": "identify_user",
          "args": {
            "label": "Ada"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_request",
              "param": "click_id",
              "http_status": null
            }
          }
        },
        {
          "call": "identify_user",
          "args": {
            "app_id": "app_01JCK8Z9V7Q4M2N6P8R0S2T4AP"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_request",
              "param": "installation_id",
              "http_status": null
            }
          }
        }
      ],
      "expect": {
        "requests": []
