    {
      "id": "ads_matching.goal.invalid_hash",
      "description": "A value that is not 64 lowercase hex characters is refused locally (invalid_hashed_identifier); nothing is sent",
      "steps": [
        {
          "call": "goals.send",
          "args": {
            "key": "account_opened",
            "reference": "APP-1",
            "hashed_email": "0F096D5DE5CCB3A1E50F34246AAB7D9C539DE7BD63498D5FAE420ECFBA31AAED"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_hashed_identifier",
              "param": "hashed_email",
              "http_status": null
            }
          }
        },
        {
          "call": "goals.send",
          "args": {
            "key": "account_opened",
            "reference": "APP-1",
            "hashed_phone_e164": "+2348031234567"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_hashed_identifier",
              "param": "hashed_phone_e164",
              "http_status": null,
              "message_excludes": [
                "+2348031234567"
              ]
            }
          }
        },
        {
          "call": "goals.send_batch",
          "args": {
            "events": [
              {
                "goal": "account_opened",
                "reference": "APP-1"
              },
              {
                "goal": "account_opened",
                "reference": "APP-2",
                "hashed_phone_digits": "abc"
              }
            ]
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_hashed_identifier",
              "param": "hashed_phone_digits",
              "http_status": null,
              "index": 1
            }
          }
        }
      ],
      "expect": {
        "requests": []
      },
      "now_ms": 1793016000000
    },
