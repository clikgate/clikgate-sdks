{
  "$schema": "../schema/case.schema.json",
  "suite": "ads_matching",
  "description": "Hashed email and phone for ad network matching: hash_for_ads and the goal options (SPEC 25; backend change 19 B.5, R.5)",
  "cases": [
    {
      "id": "ads_matching.hash_for_ads.vectors",
      "description": "hash_for_ads trims and lowercases the email and hashes the phone with and without the +; 00 works like +",
      "steps": [
        {
          "call": "hash_for_ads",
          "args": {
            "email": "  Ada.Obi@Example.com ",
            "phone": "+234 803 123 4567"
          },
          "expect": {
            "result": {
              "hashed_email": "0f096d5de5ccb3a1e50f34246aab7d9c539de7bd63498d5fae420ecfba31aaed",
              "hashed_phone_e164": "6b39248188406864f30420963a3e793bf8571e2fa733f767889f9fa882b5d14c",
              "hashed_phone_digits": "fe144b034b54f22ea55473f479fe83b2ccbc55af8cdb280ef65ef280bcd4bf17"
            }
          }
        },
        {
          "call": "hash_for_ads",
          "args": {
            "phone": "00234 (803) 123-4567"
          },
          "expect": {
            "result": {
              "hashed_phone_e164": "6b39248188406864f30420963a3e793bf8571e2fa733f767889f9fa882b5d14c",
              "hashed_phone_digits": "fe144b034b54f22ea55473f479fe83b2ccbc55af8cdb280ef65ef280bcd4bf17"
            }
          }
        },
        {
          "call": "hash_for_ads",
          "args": {
            "email": "ada.obi@example.com"
          },
          "expect": {
            "result": {
              "hashed_email": "0f096d5de5ccb3a1e50f34246aab7d9c539de7bd63498d5fae420ecfba31aaed"
            }
          }
        }
      ],
      "expect": {
        "requests": []
      },
      "now_ms": 1793016000000
    },
    {
      "id": "ads_matching.hash_for_ads.refused",
      "description": "A phone without its country code, a too short phone or an email without @ is invalid_argument; the input is never echoed",
      "steps": [
        {
          "call": "hash_for_ads",
          "args": {
            "phone": "0803 123 4567"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_argument",
              "param": "phone",
              "http_status": null,
              "message_excludes": [
                "0803 123 4567"
              ]
            }
          }
        },
        {
          "call": "hash_for_ads",
          "args": {
            "phone": "+12345"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_argument",
              "param": "phone",
              "http_status": null,
              "message_excludes": [
                "+12345"
              ]
            }
          }
        },
        {
          "call": "hash_for_ads",
          "args": {
            "phone": "+0803 123 4567"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_argument",
              "param": "phone",
              "http_status": null,
              "message_excludes": [
                "+0803 123 4567"
              ]
            }
          }
        },
        {
          "call": "hash_for_ads",
          "args": {
            "email": "ada.obi.example.com"
          },
          "expect": {
            "error": {
              "class": "InvalidRequestError",
              "code": "invalid_argument",
              "param": "email",
              "http_status": null,
              "message_excludes": [
                "ada.obi.example.com"
              ]
            }
          }
        }
      ],
      "expect": {
        "requests": []
      },
      "now_ms": 1793016000000
    },
